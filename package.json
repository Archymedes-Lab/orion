{
  "name": "orion",
  "version": "0.2.0-beta.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src server",
    "typecheck": "tsc --noEmit && cd web && tsc --noEmit",
    "test": "bun test tests",
    "test:engine": "bun test tests/decision-engine.test.js",
    "server": "ORION_SERVE=1 bun server/index.ts",
    "build:web": "bun scripts/build-web.ts",
    "serve": "ORION_SERVE=1 ORION_STATIC_DIR=dist bun server/index.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "deploy:vercel": "bun run build:web && scripts/vercel-output.sh && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@tanstack/react-query": "^5.59.0",
    "animejs": "4.5.0",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.2",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "eslint": "^9.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
